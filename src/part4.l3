; Signature: last-item(lst)
; Type: List(T) -> T
; Purpose: Retrives the last item in the list
; Pre-conditions: List is not empty
; Tests: (last-item '(1 2 3)) -> 3, (last-item '("x" "q" "c")) -> "c"
(define last-item
  (λ (lst)
    (if(eq? (cdr lst) `())
      (car lst)
      (last-item (cdr lst))
    )
  )
)

; Signature: remove-last-item(lst)
; Type: List(T) -> List(T)
; Purpose: Removes the last item in the list
; Pre-conditions: List is not empty
; Tests: (remove-last-item '("x" "q" "c")) -> `("x" "q")
(define remove-last-item
  (λ (lst)
    (if (eq? (cdr lst) `())
      `()
      (cons (car lst) (remove-last-item (cdr lst)))
    ))
)

; Signature: rotate-nth(lst, n)
; Type: List(T)*Number -> List(T)
; Purpose: Rotates list n times to the right
; Pre-conditions: List is not empty, n is a non-negative number
; Tests: (rotate-nth '(1 2 3) 1) => (3 1 2)
(define rotate-nth
  (λ (lst n)
    (if (> n 0) 
        (rotate-nth (cons (last-item lst) (remove-last-item lst)) (- n 1) ) 
        lst 
    )
  )
)


; Signature: deep-reverse(lst)
; Type: List(T) -> List(T) or T
; Purpose: gets a nested list and returns a list with all elements reversed at every level of nesting, if lst is not a list but an element, reutrn the element
; Pre-conditions: Get a list or element
; Tests: (deep-reverse '(1 (2 3) 4)) => '(4 (3 2) 1), (deep-reverse '((a r b a d a k) (a r b a))) = > '((a b r a) (k a d a b r a))
(define deep-reverse
  (λ (lst)
    (if (list? lst) 
      (if (eq? lst '())
        '()
        (if (eq? (cdr lst) '())
          (cons (deep-reverse(car lst)) '())
          (cons (deep-reverse (last-item lst)) (deep-reverse(remove-last-item lst) ) )
        )
      )
      lst
    )
  )
)